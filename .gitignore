docs/
*.ncu-rep
.gitignore
__pycache__/
*.pyc
*.pyo

# Environment and build artifacts
.env
*.egg-info/

# Pipeline output files (includes all compiled binaries, keep README.md for documentation)
pipeline_output/*
!pipeline_output/README.md
kernelopt/pipeline_output*/

# benchmarks/ directory removed — superseded by tests_suite/benchmarks/ + eval_benchmark.py
benchmarks/

# Local virtual environments
.bench_venv/
.pipeline_venv/

# Benchmark zip archives
kb_benchmark_results*.zip

# Development bench/eval scripts (not part of the package)
# Scripts relocated to scripts/ are tracked; root-level copies are ignored
bench_k*.py
/eval_*.py
eval_benchmark_results/
/run_*.py
/run_*.sh
run_*.log
/launch_benchmark.sh
/collect_benchmark.py
run_audit.md
run_wallclock_bench*.sh
!scripts/
run_multikernel_bench.sh

# Log output files
*.log
!benchmark_results/**/run.log
batch_20_100_master.log
output*.log

# Benchmark result directories (raw output — not committed)
kb_benchmark_results*/

# Cleaned benchmark results (committed)
# benchmark_results/ is tracked — excludes .ncu-rep (in global rule),
# pipeline_checkpoint.json, and master.log
benchmark_results/**/pipeline_checkpoint.json
benchmark_results/**/master.log
l1_batch_results/
batch_20_100/
tests_suite/test_data/

# Diagram/image dev outputs
kernelopt_diagram.py
kernelopt_diagram.png
kernelopt_flow.html
image.png

# Internal planning docs
claude_code_handoff_v2.md
audit_orchestrator_prompt.md
audit_prompts.md

# Internal development artifacts (not for upstream)
.claude/
pipeline_output/
l1_batch_results/
