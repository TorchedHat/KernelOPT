# Vertex AI Configuration
# Required: Your Google Cloud project ID with Vertex AI API enabled
export ANTHROPIC_VERTEX_PROJECT_ID=your-project-id-here

# Optional: Vertex AI region (defaults to us-east5)
export VERTEX_REGION=us-east5

# Performance Configuration
# Fixes OpenBLAS threading issues
export OPENBLAS_NUM_THREADS=1

# Optional: Service Account Key (if not using gcloud auth)
# export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Add gcloud to PATH (if installed in custom location)
# export PATH="$HOME/google-cloud-sdk/bin:$PATH"

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Load it: source .env
# 4. Or run setup script: python setup_environment.py
