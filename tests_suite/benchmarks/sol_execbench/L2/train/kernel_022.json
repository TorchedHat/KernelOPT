{
  "name": "023_video_latent_vae_encoder_downsampling",
  "description": "VAE encoder downsampling block for video-to-latent compression. Converts raw video frames to compressed latent representations through spatial and temporal downsampling with 3D convolutions, group normalization, SiLU activations, and residual connections.",
  "hf_id": "Wan-AI/Wan2.2-T2V-A14B",
