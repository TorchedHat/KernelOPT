{
  "name": "024_rmsnorm_h2048",
  "description": "Root Mean Square Normalization with hidden_size=2048. Captured from Qwen3-30B-A3B. Epsilon is fixed at 1e-6.",
  "hf_id": "",
  "axes": "{\"batch_size\": {\"type\": \"var\"}, \"hidden_size\": {\"type\": \"const\", \"value\": 2048}}",
  "inputs": "{\"hidden_states\": {\"shape\": [\"batch_size\", \"hidden_size\"], \"dtype\": \"bfloat16\"}, \"weight\": {\"shape\": [\"hidden_size\"], \"dtype\": \"bfloat16\"}}",
  "outputs": "{\"output\": {\"shape\": [\"batch_size\", \"hidden_size\"], \"dtype\": \"bfloat16\"}}",
  "reference": "import torch\n\n@torch.no_grad()\ndef run(hidden_states, weight):\n    batch_size, hidden_size = hidden_states.shape\n    # Check constants\n    assert hidden_size == 2048\n\n    EPS = 1e-6\n\n    x = hidden_states.to(torch.float32)\n    inv_rms = torch.rsqrt(x.pow(2).mean(dim=-1, keepdim=True) + EPS)\n    y = (x * inv_rms) * weight.to(torch.float32)\n    return y.to(hidden_states.dtype)",
  "custom_inputs_entrypoint": null,
  "workloads": "[{\"uuid\": \"50bbd632-cf16-4021-885b-625552ab8262\", \"axes\": {\"batch_size\": 6}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"b8b3dda7-8959-4a11-bd6a-59863bc6fffc\", \"axes\": {\"batch_size\": 1}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"90ca7f35-1e84-43ae-ac4b-805bc012d842\", \"axes\": {\"batch_size\": 34}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"7fd55dbb-7371-4b46-99d1-84d1e3f16f06\", \"axes\": {\"batch_size\": 79}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"932f75f9-e29a-4502-8794-68347b591fd5\", \"axes\": {\"batch_size\": 16254}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"68e79061-ffd0-4733-958a-3415321da93b\", \"axes\": {\"batch_size\": 12383}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"74280ca1-cb97-433d-b8a9-c2aec2ae560c\", \"axes\": {\"batch_size\": 64}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}]"
