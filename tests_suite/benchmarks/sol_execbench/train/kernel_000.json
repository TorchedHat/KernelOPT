{
  "name": "001_fused_add_rmsnorm_h2048",
  "description": "Fused Add + RMSNorm with hidden_size=2048 for Qwen3-30B-A3B. Epsilon is fixed at 1e-6.",
  "hf_id": "",
  "axes": "{\"batch_size\": {\"type\": \"var\"}, \"hidden_size\": {\"type\": \"const\", \"value\": 2048}}",
  "inputs": "{\"hidden_states\": {\"shape\": [\"batch_size\", \"hidden_size\"], \"dtype\": \"bfloat16\"}, \"residual\": {\"shape\": [\"batch_size\", \"hidden_size\"], \"dtype\": \"bfloat16\"}, \"weight\": {\"shape\": [\"hidden_size\"], \"dtype\": \"bfloat16\"}}",
  "outputs": "{\"output\": {\"shape\": [\"batch_size\", \"hidden_size\"], \"dtype\": \"bfloat16\"}}",
  "reference": "import torch\n\n@torch.no_grad()\ndef run(hidden_states, residual, weight):\n    _, hidden_size = hidden_states.shape\n    # Check constants\n    assert hidden_size == 2048\n\n    EPS = 1e-6\n\n    x = hidden_states.to(torch.float32) + residual.to(torch.float32)\n    inv_rms = torch.rsqrt(x.pow(2).mean(dim=-1, keepdim=True) + EPS)\n    y = (x * inv_rms) * weight.to(torch.float32)\n    return y.to(hidden_states.dtype)",
  "custom_inputs_entrypoint": null,
  "workloads": "[{\"uuid\": \"906efdc6-aa3b-4b4f-a291-3a2be509d354\", \"axes\": {\"batch_size\": 6}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"1526086b-0c06-41a1-b7b9-47b5cfc830d7\", \"axes\": {\"batch_size\": 1}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"78c9b621-e151-4fb2-9162-f1b39afe573a\", \"axes\": {\"batch_size\": 34}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"7fd454c3-9611-4376-a920-3d1c30639790\", \"axes\": {\"batch_size\": 79}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"724a6dfa-06ff-45b7-9972-d174a0e23737\", \"axes\": {\"batch_size\": 16254}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"5ede385e-9b04-4b49-903f-375a5180d815\", \"axes\": {\"batch_size\": 12383}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, {\"uuid\": \"1602b8db-16e2-4d3f-b63d-68d4ee32e2cc\", \"axes\": {\"batch_size\": 64}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}]"
