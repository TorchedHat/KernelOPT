# Test Environment Configuration

# =============================================================================
# GPU Configuration (H200 Optimized)
# =============================================================================

# GPU device ID to use for tests
# If not set, tests will prompt for interactive selection
TEST_GPU_ID=2

# Skip GPU resource checking (not recommended)
# SKIP_GPU_CHECK=1

# =============================================================================
# Claude Vertex AI Configuration
# =============================================================================

# Vertex AI project ID (required for agent tests)
ANTHROPIC_VERTEX_PROJECT_ID=your-project-id

# Vertex AI region
VERTEX_REGION=us-east5

# =============================================================================
# Test Configuration
# =============================================================================

# Default model for tests (matches production)
TEST_MODEL=claude-sonnet-4@20250514

# Test timeouts (seconds)
TEST_TIMEOUT_UNIT=30
TEST_TIMEOUT_INTEGRATION=120
TEST_TIMEOUT_E2E=600
TEST_TIMEOUT_AGENT=180

# =============================================================================
# Profiling Configuration (H200 Specific)
# =============================================================================

# Minimum free GPU memory percentage for profiling tests
MIN_FREE_MEMORY_PCT=40.0

# Maximum GPU utilization for profiling tests
MAX_GPU_UTIL_PCT=20.0

# Warmup iterations for H200
WARMUP_ITERATIONS=10

# Benchmark iterations for H200
BENCHMARK_ITERATIONS=100

# =============================================================================
# Test Data Paths
# =============================================================================

# Path to test kernels
TEST_KERNELS_DIR=test/fixtures/kernels

# Path to sample NCU CSVs
TEST_DATA_DIR=test/fixtures/data

# Temporary output directory for tests
TEST_OUTPUT_DIR=/tmp/kernelopt_test

# =============================================================================
# CI/CD Configuration
# =============================================================================

# Set to 1 in CI environments
# CI=1

# Parallel test execution workers
# PYTEST_WORKERS=4
