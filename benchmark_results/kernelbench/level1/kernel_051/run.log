        # Vectorization hints: r_offsets is contiguous and BLOCK_R-aligned
        r_offsets = tl.max_contiguous(tl.multiple_of(r_offsets, BLOCK_R), 
BLOCK_R)
        mask = r_offsets < R
        # Load x
        ptrs = base + r_offsets * N
        vals = tl.load(ptrs, mask=mask, other=float('-inf'), 
cache_modifier='evict_first')
