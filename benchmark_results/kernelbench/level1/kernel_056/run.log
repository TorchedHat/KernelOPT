def triton_poi_fused_convolution_2(in_ptr0, in_ptr1, out_ptr0, ynumel, xnumel, 
YBLOCK : tl.constexpr, XBLOCK : tl.constexpr):
    # Reinterpret: XBLOCK = TILE_C (channel tiles, stride-1 for loads)
    #              YBLOCK = TILE_S (spatial tiles, stride-1 for stores)
    # pid(0) -> spatial tiles, pid(1) -> (n,c) tiles
    pid_s  = tl.program_id(0)   # spatial tile index
    pid_nc = tl.program_id(1)   # (batch * channel) tile index

    # YBLOCK covers spatial dimension S=3025 (stride-1 in output)
    s_off  = pid_s  * YBLOCK + tl.arange(0, YBLOCK)
    # XBLOCK covers channel*batch dimension NC=24576 (stride-1 in input)
    nc_off = pid_nc * XBLOCK + tl.arange(0, XBLOCK)
